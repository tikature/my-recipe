{
    "builds": [
        {
            "src": "api/*.go",
            "use": "@vercel/go"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/api/index.go"
        },
        {
            "src": "/resep/(.*)",
            "dest": "/api/resep.go?id=$1"
        }
    ]
}